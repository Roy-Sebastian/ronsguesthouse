DATABASE_URL="postgresql://postgres:123456@localhost:5432/rons_guesthouse_DEV"
BETTER_AUTH_SECRET="your_super_secret_key"
BETTER_AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# Comma-separated — add both www and non-www in production
# e.g. FRONTEND_URL="https://ronsguesthouse.com,https://www.ronsguesthouse.com"
FRONTEND_URL="http://localhost:3000"
# Set to ".ronsguesthouse.com" in production for cross-subdomain cookie sharing
COOKIE_DOMAIN=""

# Midtrans (set MIDTRANS_IS_PRODUCTION=true and use production keys for live environment)
MIDTRANS_SERVER_KEY="your_midtrans_server_key"
MIDTRANS_CLIENT_KEY="your_midtrans_client_key"
MIDTRANS_IS_PRODUCTION="false"

# Booking Config
BOOKING_EXPIRY_MINUTES="15"
BOOKING_TX_TIMEOUT_MS="10000"

# Resend API
RESEND_API_KEY="your_resend_api_key"
EMAIL_FROM="onboarding@resend.dev"

# Security
KTP_ENCRYPTION_KEY="your_32_byte_base64_key"

# Cloudinary (file upload storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
